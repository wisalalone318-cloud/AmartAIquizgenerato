<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MasterClass AI Quiz Studio Pro</title>
    <!-- Include html2pdf library for PDF export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        :root {
            --primary: #0f766e;
            --primary-dark: #115e59;
            --primary-light: #2dd4bf;
            --accent: #f0fdf4;
            --text-main: #1f2937;
            --text-muted: #4b5563;
            --bg-body: #f8fafc;
            --white: #ffffff;
            --border: #cbd5e1;
            --danger: #ef4444;
            --success: #10b981;
            --warning: #f59e0b;
        }

        [data-theme="dark"] {
            --primary: #14b8a6;
            --primary-dark: #0f766e;
            --primary-light: #5eead4;
            --accent: #064e3b;
            --text-main: #f1f5f9;
            --text-muted: #94a3b8;
            --bg-body: #0f172a;
            --white: #1e293b;
            --border: #334155;
            --danger: #f87171;
            --success: #34d399;
            --warning: #fbbf24;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            margin: 0;
            padding: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow-x: hidden;
            transition: background-color 0.3s, color 0.3s;
        }

        .studio-container {
            width: 100%;
            max-width: 760px;
            background: var(--white);
            border-radius: 16px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            border: 1px solid var(--border);
            animation: fadeIn 0.4s ease-out;
            position: relative;
        }

        header {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: #ffffff;
            padding: 24px;
            text-align: center;
            position: relative;
        }

        header h1 {
            margin: 0;
            font-size: 1.4rem;
            letter-spacing: 0.5px;
        }

        header p {
            margin: 6px 0 0;
            font-size: 0.85rem;
            opacity: 0.9;
        }

        .top-utility-bar {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 14px;
            flex-wrap: wrap;
        }

        .utility-icon-btn {
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: #ffffff;
            padding: 6px 14px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.82rem;
            font-weight: 600;
            transition: background 0.2s;
        }

        .utility-icon-btn:hover {
            background: rgba(255, 255, 255, 0.35);
        }

        .gamification-widget {
            display: flex;
            justify-content: space-around;
            background: rgba(0, 0, 0, 0.15);
            padding: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin-top: 15px;
        }

        .view-section {
            padding: 30px;
            display: none;
        }

        .view-section.active {
            display: block;
            animation: slideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.6);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 10000;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.open {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-card {
            background: var(--white);
            color: var(--text-main);
            padding: 25px;
            border-radius: 12px;
            width: 90%;
            max-width: 420px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            border: 1px solid var(--border);
        }

        .mode-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            background: var(--border);
            padding: 5px;
            border-radius: 8px;
        }

        .tab-btn {
            flex: 1;
            padding: 10px;
            border: none;
            background: transparent;
            font-weight: 600;
            cursor: pointer;
            border-radius: 6px;
            font-size: 0.9rem;
            color: var(--text-muted);
            transition: all 0.2s;
        }

        .tab-btn.active {
            background: var(--white);
            color: var(--primary);
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        }

        .input-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            font-size: 0.95rem;
        }

        textarea, input[type="text"], input[type="password"] {
            width: 100%;
            padding: 12px;
            border: 1px solid var(--border);
            background: var(--white);
            color: var(--text-main);
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.9rem;
            box-sizing: border-box;
            resize: vertical;
            transition: border-color 0.2s;
        }

        textarea {
            height: 160px;
        }

        textarea:focus, input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
        }

        .format-hint {
            background: var(--border);
            padding: 12px 15px;
            border-radius: 6px;
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 20px;
            border-left: 3px solid var(--primary);
        }

        .format-hint code {
            background: var(--white);
            padding: 2px 5px;
            border-radius: 4px;
            color: var(--primary-dark);
        }

        .btn {
            background-color: var(--primary);
            color: #ffffff;
            border: none;
            padding: 14px;
            font-size: 1rem;
            font-weight: 600;
            width: 100%;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
            margin-bottom: 10px;
            text-align: center;
            display: block;
            text-decoration: none;
            box-sizing: border-box;
        }

        .btn:hover {
            background-color: var(--primary-dark);
        }

        .btn-secondary {
            background-color: #64748b;
            color: #ffffff;
        }

        .btn-secondary:hover {
            background-color: #475569;
        }

        .btn-outline {
            background-color: transparent;
            border: 1px solid var(--primary);
            color: var(--primary);
        }

        .btn-outline:hover {
            background-color: var(--accent);
        }

        .quiz-top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-muted);
        }

        .timer-badge {
            background: #fef2f2;
            color: var(--danger);
            padding: 4px 10px;
            border-radius: 20px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 5px;
            border: 1px solid #fca5a5;
        }

        .timer-badge.warning {
            animation: pulse 1s infinite;
        }

        .progress-bar-container {
            width: 100%;
            height: 8px;
            background: var(--border);
            border-radius: 4px;
            margin-bottom: 25px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: var(--primary);
            width: 0%;
            transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .question-header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .question-title {
            font-size: 1.2rem;
            font-weight: 700;
            line-height: 1.5;
            flex: 1;
        }

        .tts-btn {
            background: var(--accent);
            border: 1px solid var(--primary-light);
            color: var(--primary-dark);
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: background 0.2s;
        }

        .tts-btn:hover {
            background: var(--border);
        }

        .options-grid {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 25px;
        }

        .option-btn {
            padding: 14px 18px;
            background: var(--white);
            border: 1px solid var(--border);
            color: var(--text-main);
            border-radius: 8px;
            text-align: left;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .option-btn:hover {
            background: var(--border);
            border-color: var(--primary);
            transform: translateX(4px);
        }

        .option-btn.selected {
            background: var(--accent);
            border-color: var(--primary);
            color: var(--primary-dark);
            font-weight: 600;
        }

        .quiz-footer-nav {
            display: flex;
            gap: 12px;
        }

        .score-card {
            text-align: center;
            background: var(--accent);
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 20px;
            border: 1px solid var(--primary-light);
            position: relative;
        }

        .score-percentage {
            font-size: 3rem;
            font-weight: 800;
            color: var(--primary-dark);
            margin: 5px 0;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: 15px;
        }

        .stat-box {
            background: var(--white);
            padding: 10px;
            border-radius: 8px;
            border: 1px solid var(--border);
            font-size: 0.85rem;
        }

        .stat-box span {
            display: block;
            font-weight: 700;
            font-size: 1.1rem;
            color: var(--primary);
        }

        .analysis-section {
            margin-bottom: 20px;
        }

        .weak-box {
            background: #fef2f2;
            border-left: 4px solid var(--danger);
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 15px;
            color: #1f2937;
        }

        .weak-box h3 {
            margin: 0 0 8px;
            color: #991b1b;
            font-size: 0.95rem;
        }

        .suggestion-box {
            background: #eff6ff;
            border-left: 4px solid #3b82f6;
            padding: 15px;
            border-radius: 6px;
            color: #1f2937;
        }

        .suggestion-box h3 {
            margin: 0 0 8px;
            color: #1e40af;
            font-size: 0.95rem;
        }

        ul {
            margin: 0;
            padding-left: 18px;
            font-size: 0.88rem;
            line-height: 1.5;
        }

        .detailed-review-list {
            max-height: 250px;
            overflow-y: auto;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
            background: var(--white);
        }

        .review-item {
            padding: 10px 0;
            border-bottom: 1px solid var(--border);
            font-size: 0.9rem;
        }

        .review-item:last-child {
            border-bottom: none;
        }

        .multiplayer-box {
            background: var(--white);
            border: 1px dashed var(--primary);
            padding: 15px;
            border-radius: 8px;
            margin-top: 15px;
            text-align: center;
        }

        .multiplayer-box h4 {
            margin: 0 0 5px;
            color: var(--primary-dark);
        }

        .room-code-badge {
            background: var(--border);
            padding: 6px 12px;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-family: monospace;
            font-weight: 700;
            font-size: 1.1rem;
            display: inline-block;
            margin: 5px 0;
        }

        .creator-footer {
            text-align: center;
            padding: 15px;
            font-size: 0.85rem;
            color: var(--text-muted);
            border-top: 1px solid var(--border);
            background: var(--bg-body);
        }

        .creator-footer a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
        }

        .creator-footer a:hover {
            text-decoration: underline;
        }

        .popout-emoji-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            overflow: hidden;
            z-index: 9999;
        }

        .floating-emoji {
            position: absolute;
            font-size: 4rem;
            animation: explodeOut 1.5s cubic-bezier(0.1, 1, 0.3, 1) forwards;
            opacity: 0;
        }

        @keyframes explodeOut {
            0% { transform: translate(-50%, -50%) scale(0.2) rotate(0deg); opacity: 0; }
            30% { transform: translate(-50%, -50%) scale(1.6) rotate(15deg); opacity: 1; }
            70% { transform: translate(-50%, -50%) scale(1.2) rotate(-10deg); opacity: 1; }
            100% { transform: translate(-50%, -180px) scale(0.8) rotate(20deg); opacity: 0; }
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.97); }
            to { opacity: 1; transform: scale(1); }
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>

<div class="studio-container" id="pdfExportContainer">
    <header>
        <h1>MasterClass AI Quiz Studio Pro</h1>
        <p>Unlimited Quiz Paste Engine: Multiplayer, Timer & Analytics</p>
        
        <div class="top-utility-bar">
            <button class="utility-icon-btn" onclick="toggleDarkMode()">🌓 Theme</button>
            <button class="utility-icon-btn" onclick="openLeaderboardModal()">🏆 Leaderboard</button>
        </div>

        <div class="gamification-widget">
            <span>🔥 Streak: <strong id="widgetStreak">1</strong> days</span>
            <span>⭐ XP: <strong id="widgetXP">0</strong></span>
            <span>🪙 Coins: <strong id="widgetCoins">50</strong></span>
            <span>🎖️ Level: <strong id="widgetLevel">1</strong></span>
        </div>
    </header>

    <!-- VIEW 1: SETUP & MODES -->
    <div id="setupView" class="view-section active">
        <div class="mode-tabs">
            <button class="tab-btn active" id="tabPaste" onclick="switchMode('paste')">📋 Paste Unlimited Text</button>
            <button class="tab-btn" id="tabWeak" onclick="switchMode('weak')">♻️ Spaced Weak Review (<span id="weakCountBadge">0</span>)</button>
        </div>

        <div id="pasteModeSection">
            <div class="format-hint">
                <strong>Multi-Format Support Active:</strong>
                <br>Aap <code>1-A</code>, <code>1A</code>, commas wale format (<code>1-B, 2-C</code>) ya har MCQ ke aakhir mein likha hua answer (jaise <code>Ans: B</code>) teeno formats istemal kar sakte hain!
            </div>

            <div class="input-group">
                <label for="rawInput">Paste Unlimited Quiz Text (Leave blank to load sample demo)</label>
                <textarea id="rawInput" placeholder="Paste questions here..."></textarea>
            </div>

            <button class="btn" onclick="initializeQuiz('standard')">🚀 Launch Unlimited Quiz Session</button>
            
            <!-- Direct Download / Hosting Link Added Here -->
            <a href="index.html" download="MasterClass_Quiz_Studio.html" class="btn btn-outline" style="margin-top: 10px;">
                📥 Download Source / App File
            </a>

            <div class="multiplayer-box">
                <h4>⚔️ Multiplayer Peer Battle Mode</h4>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin: 5px 0;">Generate a shareable live room session code to race friends.</p>
                <div id="roomCodeDisplay" style="display:none;">
                    Active Room ID: <div class="room-code-badge" id="generatedRoomCode">---</div>
                </div>
                <button class="btn btn-outline" style="margin-top: 8px; margin-bottom: 0;" onclick="createMultiplayerRoom()">Create Live Battle Link</button>
            </div>
        </div>

        <div id="weakModeSection" style="display: none;">
            <div class="format-hint" style="border-left-color: var(--danger);">
                <strong>Spaced Repetition System:</strong> Reviewing questions you previously missed or timed out on. Master these to strengthen your retention.
            </div>
            <button class="btn" onclick="initializeQuiz('weak')">♻️ Launch Weak-Point Review Session</button>
        </div>
    </div>

    <!-- VIEW 2: ACTIVE QUIZ -->
    <div id="quizView" class="view-section">
        <div class="quiz-top-bar">
            <span id="questionCounter">Question 1 of 5</span>
            <div style="display: flex; gap: 8px; align-items: center;">
                <button class="btn btn-outline" style="padding: 4px 10px; font-size: 0.8rem; margin: 0;" onclick="returnToMainMenu()">🏠 Main Menu</button>
                <div class="timer-badge" id="timerBadge">⏱️ <span id="timeLeft">15</span>s</div>
            </div>
        </div>
        <div class="progress-bar-container">
            <div id="progressFill" class="progress-fill"></div>
        </div>

        <div class="question-header-row">
            <div class="question-title" id="questionText">Loading Question...</div>
            <button class="tts-btn" onclick="readQuestionAloud()" title="Read Aloud">🔊 Read</button>
        </div>

        <div class="options-grid" id="optionsContainer"></div>

        <div class="quiz-footer-nav" id="quizFooterNav">
            <button class="btn btn-secondary" id="backBtn" onclick="prevQuestion()" style="display: none; flex: 1;">Back</button>
            <button class="btn" id="nextBtn" onclick="handleNextClick()" disabled style="opacity: 0.5; flex: 2;">Next Question</button>
        </div>
    </div>

    <!-- VIEW 3: REVIEW, PERCENTAGE, WEAK TOPICS & EXPORTS -->
    <div id="reviewView" class="view-section">
        <div class="score-card">
            <h3>Assessment Complete</h3>
            <div class="score-percentage" id="finalScorePercent">0%</div>
            <p id="scoreSubText" style="margin: 0; font-size: 0.95rem; color: var(--text-muted);">-</p>
            
            <div class="stats-grid">
                <div class="stat-box">Correct <span id="statCorrect">0</span></div>
                <div class="stat-box">Incorrect <span id="statIncorrect">0</span></div>
                <div class="stat-box">Time Expired <span id="statTimeout">0</span></div>
            </div>
        </div>

        <div class="analysis-section">
            <div class="weak-box" id="weakPointsContainer" style="display: none;">
                <h3>⚠️ Targeted Weak Topics to Revise</h3>
                <ul id="weakList"></ul>
            </div>

            <div class="suggestion-box">
                <h3>💡 AI Personalized Study Suggestions</h3>
                <ul id="suggestionList"></ul>
            </div>
        </div>

        <label style="margin-bottom: 8px;">Question-by-Question Review Log</label>
        <div class="detailed-review-list" id="detailedReviewContainer"></div>

        <button class="btn" onclick="exportReportPDF()">📥 Download Results & PDF Report</button>
        <button class="btn btn-outline" onclick="shareScoreCard()">📤 Share Score Broadcast</button>
        <button class="btn btn-secondary" onclick="generateCertificate()">🎖️ Claim Verified Certificate</button>
        <button class="btn btn-outline" onclick="resetStudio()" style="margin-top: 10px;">Start New Session</button>
    </div>

    <div class="creator-footer">
        Developed by <strong>Wisal Khayal</strong> | Contact for dealing<br>
        📱 WhatsApp: <a href="https://wa.me/923352008780" target="_blank">03352008780</a> | ✉️ Email: <a href="mailto:muhammadwisal625@gmail.com">muhammadwisal625@gmail.com</a>
    </div>
</div>

<div class="modal-overlay" id="leaderboardModal" onclick="if(event.target === this) closeLeaderboardModal();">
    <div class="modal-card" onclick="event.stopPropagation();">
        <h3 style="margin-top: 0; color: var(--primary);">🏆 Global Leaderboard & Rewards</h3>
        <p style="font-size: 0.85rem; color: var(--text-muted);">Top ranked scholars for this session cycle.</p>
        <div style="background: var(--border); padding: 10px; border-radius: 8px; font-size: 0.9rem; margin-bottom: 15px;">
            <div style="display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid var(--border);">
                <span>1. 🥇 Alexander V.</span><span>2,840 XP</span>
            </div>
            <div style="display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid var(--border);">
                <span>2. 🥈 Dr. Sarah M.</span><span>2,410 XP</span>
            </div>
            <div style="display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid var(--border);">
                <span>3. 🥉 Scholar</span><span id="myRankXP">1,150 XP</span>
            </div>
        </div>
        <h4 style="margin: 0 0 8px; font-size: 0.95rem;">🎁 Rewards Store (Redeem Coins)</h4>
        <button class="btn btn-outline" style="font-size: 0.85rem; padding: 8px;" onclick="redeemReward('Theme Pack')">Unlock Pro Dark Accent (100 Coins)</button>
        <button class="btn btn-secondary" style="margin-top: 15px; margin-bottom: 0;" onclick="closeLeaderboardModal()">Close</button>
    </div>
</div>

<div class="popout-emoji-overlay" id="emojiOverlay"></div>

<script>
    let questions = [];
    let currentIndex = 0;
    let userAnswers = [];
    let timerInterval = null;
    let timeLeft = 15;
    let timeoutCount = 0;
    
    let userState = JSON.parse(localStorage.getItem('masterclass_user_state') || JSON.stringify({
        xp: 120,
        coins: 50,
        level: 1,
        streak: 1,
        certificates: 0
    }));

    window.addEventListener('DOMContentLoaded', () => {
        updateGamificationUI();
    });

    let weakQuestionBank = JSON.parse(localStorage.getItem('masterclass_weak_bank') || '[]');
    updateWeakCountBadge();

    const defaultDemoQuestions = [
        {
            question: "Which cellular organelle is primarily responsible for generating ATP through cellular respiration?",
            options: ["Ribosome", "Mitochondria", "Endoplasmic Reticulum", "Golgi Apparatus"],
            answer: 1,
            topic: "Cellular Bioenergetics"
        },
        {
            question: "What is the primary chemical buffer system regulating physiological human blood pH?",
            options: ["Bicarbonate buffer system", "Phosphate buffer system", "Protein buffer system", "Ammonia buffer system"],
            answer: 0,
            topic: "Homeostasis & Physiology"
        },
        {
            question: "During which specific phase of mitosis do sister chromatids separate apart?",
            options: ["Prophase", "Metaphase", "Anaphase", "Telophase"],
            answer: 2,
            topic: "Cell Division & Genetics"
        },
        {
            question: "Which lipid classification forms the primary structural bilayer of cell membranes?",
            options: ["Triglycerides", "Phospholipids", "Glycogen", "Sterols"],
            answer: 1,
            topic: "Cellular Bioenergetics"
        },
        {
            question: "In enzyme kinetics, what structural region does a competitive inhibitor bind to?",
            options: ["Allosteric regulatory site", "Active catalytic site", "Substrate directly", "Coenzyme complex"],
            answer: 1,
            topic: "Enzyme Kinetics"
        }
    ];

    function toggleDarkMode() {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        if (currentTheme === 'dark') {
            document.documentElement.removeAttribute('data-theme');
            localStorage.setItem('masterclass_theme', 'light');
        } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            localStorage.setItem('masterclass_theme', 'dark');
        }
    }

    if (localStorage.getItem('masterclass_theme') === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
    }

    function openLeaderboardModal() {
        document.getElementById('leaderboardModal').classList.add('open');
        document.getElementById('myRankXP').innerText = `${userState.xp} XP`;
    }
    function closeLeaderboardModal() {
        document.getElementById('leaderboardModal').classList.remove('open');
    }

    function saveUserState() {
        localStorage.setItem('masterclass_user_state', JSON.stringify(userState));
    }

    function updateGamificationUI() {
        document.getElementById('widgetStreak').innerText = userState.streak;
        document.getElementById('widgetXP').innerText = userState.xp;
        document.getElementById('widgetCoins').innerText = userState.coins;
        document.getElementById('widgetLevel').innerText = userState.level;
    }

    function switchMode(mode) {
        document.getElementById('tabPaste').classList.toggle('active', mode === 'paste');
        document.getElementById('tabWeak').classList.toggle('active', mode === 'weak');
        document.getElementById('pasteModeSection').style.display = (mode === 'paste') ? 'block' : 'none';
        document.getElementById('weakModeSection').style.display = (mode === 'weak') ? 'block' : 'none';
    }

    function updateWeakCountBadge() {
        document.getElementById('weakCountBadge').innerText = weakQuestionBank.length;
    }

    function createMultiplayerRoom() {
        const rawText = document.getElementById('rawInput').value;
        let parsed = parsePastedText(rawText);
        const roomCode = 'BATTLE-' + Math.floor(100000 + Math.random() * 900000);
        
        sessionStorage.setItem('active_battle_room', roomCode);
        sessionStorage.setItem('battle_questions', JSON.stringify(parsed));

        document.getElementById('generatedRoomCode').innerText = roomCode;
        document.getElementById('roomCodeDisplay').style.display = 'block';
        alert(`Multiplayer Room Created Successfully!\nRoom Code: ${roomCode}\nShare this room code with peers to sync test questions.`);
    }

    // Fully sanitized & comprehensive parser supporting 1-A, 1A, and inline answers
    function parsePastedText(text) {
        if (!text || text.trim() === "") return defaultDemoQuestions;
        
        let parsed = [];
        let globalKeyMap = {};
        
        let keyPatternMatches = text.match(/(\d+)\s*[-:]?\s*([A-Da-d0-3])/g);
        if (keyPatternMatches && keyPatternMatches.length >= 2) {
            keyPatternMatches.forEach(match => {
                let parts = match.split(/[-:]/);
                if (parts.length === 2) {
                    let qNum = parseInt(parts[0].trim());
                    let ansVal = parts[1].trim().toUpperCase();
                    globalKeyMap[qNum] = convertAnsToIndex(ansVal);
                } else {
                    let numMatch = match.match(/(\d+)\s*([A-Da-d])/);
                    if (numMatch) {
                        let qNum = parseInt(numMatch[1]);
                        let ansVal = numMatch[2].toUpperCase();
                        globalKeyMap[qNum] = convertAnsToIndex(ansVal);
                    }
                }
            });
        }

        let blocks = text.split(/(?=Q\d+|\n\s*\d+[\.\)]\s+)/i).filter(b => b.trim().length > 0);
        
        if (blocks.length <= 1) {
            blocks = text.split(/\n\s*\n/).filter(b => b.trim().length > 0);
        }
        
        blocks.forEach((block, blockIdx) => {
            let lines = block.split('\n').map(l => l.trim()).filter(l => l.length > 0);
            if (lines.length >= 3) {
                let qNumMatch = lines[0].match(/^(Q(\d+)|\d+)[\.\)]?/i);
                let detectedNum = qNumMatch && qNumMatch[2] ? parseInt(qNumMatch[2]) : (qNumMatch && !isNaN(qNumMatch[1]) ? parseInt(qNumMatch[1]) : blockIdx + 1);
                
                // Aggressive cleaning to strip all unwanted symbols, markdown bolding, and trailing dots
                let qText = lines[0]
                    .replace(/^(Q\d+|\d+[\.\)])\s*/i, '')
                    .replace(/\*\*+/g, '')
                    .replace(/^\.\s*/, '')
                    .trim();
                
                let opts = [];
                let ansIndex = 0;
                let topicTag = "Custom Question Pool";

                if (globalKeyMap[detectedNum] !== undefined) {
                    ansIndex = globalKeyMap[detectedNum];
                }

                for (let i = 1; i < lines.length; i++) {
                    let line = lines[i];
                    if (line.toLowerCase().startsWith('ans') || line.toLowerCase().startsWith('answer') || line.toLowerCase().startsWith('correct')) {
                        let val = line.split(':')[1] || line.split('-')[1] || line;
                        ansIndex = convertAnsToIndex(val.trim());
                    } else if (/^[A-Da-d][\.\)]/.test(line) || opts.length < 4) {
                        let cleanedOpt = line
                            .replace(/^[A-Da-d][\.\)]?\s*/, '')
                            .replace(/\*\*+/g, '')
                            .trim();
                        opts.push(cleanedOpt);
                    }
                }

                if (opts.length >= 2) {
                    while(opts.length < 4) {
                        opts.push("Option " + (opts.length + 1));
                    }
                    parsed.push({
                        question: qText,
                        options: opts.slice(0, 4),
                        answer: ansIndex,
                        topic: topicTag
                    });
                }
            }
        });

        return parsed.length > 0 ? parsed : defaultDemoQuestions;
    }

    function convertAnsToIndex(val) {
        val = val.toUpperCase();
        if (val.startsWith('A') || val === '0') return 0;
        if (val.startsWith('B') || val === '1') return 1;
        if (val.startsWith('C') || val === '2') return 2;
        if (val.startsWith('D') || val === '3') return 3;
        return 0;
    }

    function readQuestionAloud() {
        if (!('speechSynthesis' in window)) {
            alert("Text-to-speech is not supported by your current browser.");
            return;
        }
        window.speechSynthesis.cancel();
        const q = questions[currentIndex];
        let textToSpeak = `${q.question}. Your options are: ${q.options.join(', ')}`;
        let utterance = new SpeechSynthesisUtterance(textToSpeak);
        utterance.rate = 1.0;
        window.speechSynthesis.speak(utterance);
    }

    function triggerPopoutEmoji(emojiSymbol) {
        const overlay = document.getElementById('emojiOverlay');
        const span = document.createElement('span');
        span.className = 'floating-emoji';
        span.innerText = emojiSymbol;
        
        const randomX = window.innerWidth / 2 + (Math.random() * 200 - 100);
        const randomY = window.innerHeight / 2 + (Math.random() * 100 - 50);
        
        span.style.left = `${randomX}px`;
        span.style.top = `${randomY}px`;
        
        overlay.appendChild(span);
        setTimeout(() => { span.remove(); }, 1500);
    }

    function initializeQuiz(mode) {
        if (mode === 'weak') {
            if (weakQuestionBank.length === 0) {
                alert("No weak questions recorded yet! Complete standard quizzes first.");
                return;
            }
            questions = [...weakQuestionBank];
        } else {
            const rawText = document.getElementById('rawInput').value;
            questions = parsePastedText(rawText);
        }

        currentIndex = 0;
        userAnswers = new Array(questions.length).fill(null);
        timeoutCount = 0;

        document.getElementById('setupView').classList.remove('active');
        document.getElementById('quizView').classList.add('active');
        loadQuestion();
    }

    function returnToMainMenu() {
        if (confirm("Are you sure you want to return to the main menu? Your current progress will be lost.")) {
            clearInterval(timerInterval);
            window.speechSynthesis.cancel();
            document.getElementById('quizView').classList.remove('active');
            document.getElementById('setupView').classList.add('active');
        }
    }

    function loadQuestion() {
        clearInterval(timerInterval);
        timeLeft = 15;
        document.getElementById('timeLeft').innerText = timeLeft;
        document.getElementById('timerBadge').classList.remove('warning');

        const q = questions[currentIndex];
        document.getElementById('questionCounter').innerText = `Question ${currentIndex + 1} of ${questions.length}`;
        document.getElementById('questionText').innerText = q.question;

        const progressPct = ((currentIndex + 1) / questions.length) * 100;
        document.getElementById('progressFill').style.width = `${progressPct}%`;

        document.getElementById('backBtn').style.display = currentIndex > 0 ? 'block' : 'none';

        const container = document.getElementById('optionsContainer');
        container.innerHTML = '';

        q.options.forEach((opt, idx) => {
            const btn = document.createElement('button');
            btn.className = 'option-btn';
            if (userAnswers[currentIndex] === idx) {
                btn.classList.add('selected');
            }
            btn.innerText = opt;
            btn.onclick = () => selectOption(idx);
            container.appendChild(btn);
        });

        updateNextButtonState();
        startTimer();
    }

    function startTimer() {
        timerInterval = setInterval(() => {
            timeLeft--;
            document.getElementById('timeLeft').innerText = timeLeft;
            
            if (timeLeft <= 4) {
                document.getElementById('timerBadge').classList.add('warning');
            }

            if (timeLeft <= 0) {
                clearInterval(timerInterval);
                if (userAnswers[currentIndex] === null) {
                    timeoutCount++;
                }
                nextQuestion();
            }
        }, 1000);
    }

    function selectOption(optionIndex) {
        userAnswers[currentIndex] = optionIndex;
        
        const buttons = document.querySelectorAll('.option-btn');
        buttons.forEach((btn, idx) => {
            if (idx === optionIndex) {
                btn.classList.add('selected');
            } else {
                btn.classList.remove('selected');
            }
        });

        updateNextButtonState();
    }

    function updateNextButtonState() {
        const nextBtn = document.getElementById('nextBtn');
        if (userAnswers[currentIndex] !== null) {
            nextBtn.disabled = false;
            nextBtn.style.opacity = '1';
            nextBtn.innerText = (currentIndex === questions.length - 1) ? "Finish & Review" : "Next Question";
        } else {
            nextBtn.disabled = true;
            nextBtn.style.opacity = '0.5';
            nextBtn.innerText = "Next Question";
        }
    }

    function handleNextClick() {
        clearInterval(timerInterval);
        window.speechSynthesis.cancel();
        nextQuestion();
    }

    function nextQuestion() {
        if (currentIndex < questions.length - 1) {
            currentIndex++;
            loadQuestion();
        } else {
            showReviewScreen();
        }
    }

    function prevQuestion() {
        clearInterval(timerInterval);
        window.speechSynthesis.cancel();
        if (currentIndex > 0) {
            currentIndex--;
            loadQuestion();
        }
    }

    function showReviewScreen() {
        window.speechSynthesis.cancel();
        document.getElementById('quizView').classList.remove('active');
        document.getElementById('reviewView').classList.add('active');

        let correctCount = 0;
        let incorrectCount = 0;
        let incorrectTopics = {};
        let detailedHtml = '';

        questions.forEach((q, idx) => {
            let userAns = userAnswers[idx];
            let isCorrect = (userAns === q.answer);
            
            if (isCorrect) {
                correctCount++;
                weakQuestionBank = weakQuestionBank.filter(item => item.question !== q.question);
            } else {
                incorrectCount++;
                if (!incorrectTopics[q.topic]) incorrectTopics[q.topic] = 0;
                incorrectTopics[q.topic]++;

                if (!weakQuestionBank.some(item => item.question === q.question)) {
                    weakQuestionBank.push(q);
                }
            }

            let userAnsText = userAns !== null ? q.options[userAns] : "<span style='color:var(--danger);'>⏱️ Timeout / Unanswered</span>";
            let correctAnsText = q.options[q.answer];

            detailedHtml += `
                <div class="review-item">
                    <strong>Q${idx + 1}: ${q.question}</strong><br>
                    <span style="color:${isCorrect ? 'var(--success)' : 'var(--danger)'};">Your Answer: ${userAnsText}</span><br>
                    <span style="color:var(--primary-dark);">Correct Answer: ${correctAnsText}</span>
                </div>
            `;
        });

        localStorage.setItem('masterclass_weak_bank', JSON.stringify(weakQuestionBank));
        updateWeakCountBadge();

        const percentage = Math.round((correctCount / questions.length) * 100);
        
        userState.xp += correctCount * 25;
        userState.coins += correctCount * 10;
        if (percentage >= 80) {
            userState.level += 1;
        }
        saveUserState();
        updateGamificationUI();

        document.getElementById('finalScorePercent').innerText = `${percentage}%`;
        document.getElementById('scoreSubText').innerText = `Earned +${correctCount * 25} XP & +${correctCount * 10} Coins!`;
        document.getElementById('statCorrect').innerText = correctCount;
        document.getElementById('statIncorrect').innerText = incorrectCount;
        document.getElementById('statTimeout').innerText = timeoutCount;

        document.getElementById('detailedReviewContainer').innerHTML = detailedHtml;

        if (percentage >= 85) {
            triggerPopoutEmoji('💯');
            setTimeout(() => triggerPopoutEmoji('🎉'), 300);
        } else {
            triggerPopoutEmoji('🎯');
        }

        const weakBox = document.getElementById('weakPointsContainer');
        const weakList = document.getElementById('weakList');
        weakList.innerHTML = '';

        const weakKeys = Object.keys(incorrectTopics);
        if (weakKeys.length > 0) {
            weakBox.style.display = 'block';
            weakKeys.forEach(topic => {
                const li = document.createElement('li');
                li.innerHTML = `<strong>${topic}</strong>: Recorded ${incorrectTopics[topic]} error(s). Added to Spaced Repetition queue.`;
                weakList.appendChild(li);
            });
        } else {
            weakBox.style.display = 'none';
        }

        const suggestionList = document.getElementById('suggestionList');
        suggestionList.innerHTML = '';
        let suggestions = [];

        if (percentage >= 85) {
            suggestions.push("Outstanding performance! Level progression increased successfully.");
        } else {
            suggestions.push("Solid foundation. Use the Spaced Weak Review mode to retrain on your error items.");
        }

        suggestions.forEach(s => {
            const li = document.createElement('li');
            li.innerText = s;
            suggestionList.appendChild(li);
        });
    }

    function shareScoreCard() {
        const scoreText = document.getElementById('finalScorePercent').innerText;
        if (navigator.share) {
            navigator.share({
                title: 'MasterClass AI Quiz Score',
                text: `I just scored ${scoreText} on MasterClass AI Quiz Studio Pro!`,
                url: window.location.href,
            }).catch(() => {});
        } else {
            navigator.clipboard.writeText(`I just scored ${scoreText} on MasterClass AI Quiz Studio Pro!`);
            alert("Score text copied to clipboard for social sharing!");
        }
    }

    function generateCertificate() {
        userState.certificates += 1;
        saveUserState();
        alert(`Verified Certificate of Completion Generated & Saved!\nTotal Certificates: ${userState.certificates}`);
    }

    function redeemReward(rewardName) {
        if (userState.coins >= 100) {
            userState.coins -= 100;
            saveUserState();
            updateGamificationUI();
            alert(`Successfully redeemed: ${rewardName}!`);
        } else {
            alert("Insufficient coins! Complete more quizzes to earn coins.");
        }
    }

    function exportReportPDF() {
        const element = document.getElementById('pdfExportContainer');
        const opt = {
            margin:       10,
            filename:     'MasterClass_Quiz_Performance_Report.pdf',
            image:        { type: 'jpeg', quality: 0.98 },
            html2canvas:  { scale: 2, useCORS: true },
            jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
        };
        html2pdf().from(element).set(opt).save();
    }

    function resetStudio() {
        clearInterval(timerInterval);
        window.speechSynthesis.cancel();
        document.getElementById('reviewView').classList.remove('active');
        document.getElementById('setupView').classList.add('active');
    }
</script>

</body>
</html>
